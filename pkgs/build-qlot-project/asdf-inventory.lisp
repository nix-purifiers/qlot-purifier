;;; Observe the original ASDF component graph without changing its registry.
(defun qlot-json-string (value stream)
  (write-char #\" stream)
  (loop for character across value do
    (case character
      (#\" (write-string "\\\"" stream))
      (#\\ (write-string "\\\\" stream))
      (otherwise
        (if (< (char-code character) 32)
            (format stream "\\u~4,'0X" (char-code character))
            (write-char character stream)))))
  (write-char #\" stream))

(defun qlot-asdf-inventory (destination)
  (with-open-file (stream destination :direction :output :if-exists :error)
    (write-char #\[ stream)
    (let ((first t) (seen (make-hash-table :test 'eq)))
      (labels ((emit (component)
                 (unless (gethash component seen)
                   (setf (gethash component seen) t)
                   (let ((path (asdf:component-pathname component)))
                     (when (and (asdf:component-loaded-p component) path (probe-file path) (not (uiop:directory-pathname-p path)))
                       (unless first (write-char #\, stream))
                       (setf first nil)
                       (write-string "{\"system\":" stream)
                       (qlot-json-string (asdf:component-name (asdf:component-system component)) stream)
                       (write-string ",\"source\":" stream)
                       (qlot-json-string (namestring (truename path)) stream)
                       (write-string ",\"outputs\":[" stream)
                       (loop for output in (asdf:output-files 'asdf:compile-op component)
                             for index from 0 do
                         (when (> index 0) (write-char #\, stream))
                         (qlot-json-string (namestring output) stream))
                       (write-string "]}" stream)))
                   (when (typep component 'asdf:parent-component)
                     (mapc #'emit (asdf:component-children component))))))
        (dolist (name (sort (copy-list (asdf:already-loaded-systems)) #'string<))
          (emit (asdf:find-system name)))))
    (write-char #\] stream)))
